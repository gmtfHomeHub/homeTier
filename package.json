{
  "name": "homeTier",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "license-file": "LICENSE",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "dev": "eslint src/ --fix && vite",
    "build": "tsc --noEmit && vite build",
    "build:server": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "tauri:build:macos": "tauri build --target aarch64-apple-darwin --bundles dmg",
    "tauri:build:macos:x86": "tauri build --target x86_64-apple-darwin --bundles dmg",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles msi --verbose",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu --bundles deb",
    "tauri:build:linux:arm": "tauri build --target aarch64-unknown-linux-gnu --bundles deb",
    "tauri:build:appimage": "tauri build --bundles appimage",
    "tauri:build:android": "tauri android build --apk --target aarch64 --target armv7 --target x86_64",
    "tauri:build:docker": "tauri build --no-bundle"
  },
  "dependencies": {
    "@iconify/react": "^6.0.2",
    "@radix-ui/themes": "^3.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-barcode-scanner": "^2.4.6",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-notification": "2.3.3",
    "@tauri-apps/plugin-os": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-shell": "^2",
    "clsx": "^2",
    "framer-motion": "^11",
    "i18next": "^23",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.400",
    "mobx-react-lite": "^5.0.3",
    "qrcode.react": "^4",
    "react": "^18.3",
    "react-dom": "^18.3",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^14",
    "react-router-dom": "^6",
    "react-window": "^2.3.0",
    "uuid": "^14.0.1",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@tauri-apps/cli": "^2",
    "@types/react": "^18.3",
    "@types/react-dom": "^18.3",
    "@vitejs/plugin-react": "^4",
    "autoprefixer": "^10",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "postcss": "^8",
    "tailwindcss": "^3",
    "typescript": "^5.5",
    "typescript-eslint": "^8.65.0",
    "vite": "^5"
  }
}
