  "identifier": "default",
  "description": "Default capability set for homeTier",
  "windows": ["main"],
  "webviews": ["main", "app-webview"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "process:default",
    "clipboard-manager:default",
    "global-shortcut:default",
    "os:default",
    "notification:default"
  ]
}