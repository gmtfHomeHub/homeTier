{
  "identifier": "default",
  "description": "Default capability set for homeTier",
  "windows": ["main"],
  "webviews": ["main", "app-webview"],
  "permissions": [
    "core:default",
    "shell:allow-open",
    "process:default",
    "clipboard-manager:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "os:default",
    "notification:default",
    "dialog:default",
    "hometiervpnservice:default"
  ],
  "platforms": ["linux", "windows", "macOS", "android", "iOS"]
}