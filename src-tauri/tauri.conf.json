{
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "resources": [
      "../homeTier.conf.example",
      "resources/bin/*"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "windows": {
      "wix": {
        "language": "zh-CN",
        "template": "resources/wix/main.wxs"
      }
    },
    "createUpdaterArtifacts": false
  },
  "productName": "homeTier",
  "version": "0.1.0",
  "identifier": "com.hometier.app",
  "plugins": {
    "shell": {
      "open": "^.+"
    }
  },
  "app": {
    "windows": [
      {
        "title": "homeTier",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "transparent": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}